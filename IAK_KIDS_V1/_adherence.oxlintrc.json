{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "archive/iak/master/lib/**",
              "archive/iak/ui_kits/rais-dashboard/**",
              "iak-kids-v2.2-templates/templates/kid-activity/**",
              "iak-kids-v2.2-templates/templates/parent-dashboard/**",
              "iak-kids-v2.2-templates/templates/weekly-schedule/**",
              "iak-kids-v2.2-templates/zem/lib/**",
              "zem/components/**",
              "zem/compositions/**",
              "zem/lib/**",
              "zem/ui_kits/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Nanum Barun Gothic))/i]",
        "message": "Font not provided by the design system. Available: Nanum Barun Gothic."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertDialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:trigger|title|description|confirmLabel|cancelLabel|danger|onConfirm|errorMessage|inline|previewState|key|ref|className|style|children)$/]",
        "message": "<AlertDialog> doesn't accept that prop. Declared props: trigger, title, description, confirmLabel, cancelLabel, danger, onConfirm, errorMessage, inline, previewState."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertDialog'] > JSXAttribute[name.name='previewState'] > Literal[value!=/^(?:pending|error)$/]",
        "message": "<AlertDialog> previewState must be one of 'pending' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|success|warning|error|accent|neutral)$/]",
        "message": "<Badge> tone must be one of 'info' | 'success' | 'warning' | 'error' | 'accent' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|loading|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, loading."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|accent|danger|text)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'accent' | 'danger' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|footer|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: title, footer."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChildSwitcherKid'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|initial|meta|key|ref|className|style|children)$/]",
        "message": "<ChildSwitcherKid> doesn't accept that prop. Declared props: id, name, initial, meta."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|done|key|ref|className|style|children)$/]",
        "message": "<TimelineStep> doesn't accept that prop. Declared props: title, done."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:trigger|title|description|children|footer|open|defaultOpen|onOpenChange|initialFocusRef|closeOnOutside|closeLabel|size|inline|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: trigger, title, description, children, footer, open, defaultOpen, onOpenChange, initialFocusRef, closeOnOutside, closeLabel, size, inline."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Dialog> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FocusSession'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|durationSec|steps|resetKey|initialPhase|initialElapsedSec|label|onStart|onPause|onResume|onComplete|onReset|className|key|ref|className|style|children)$/]",
        "message": "<FocusSession> doesn't accept that prop. Declared props: title, durationSec, steps, resetKey, initialPhase, initialElapsedSec, label, onStart, onPause, onResume, onComplete, onReset, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='GoalDraft'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|repeat|kid|time|points|reminder|memo|key|ref|className|style|children)$/]",
        "message": "<GoalDraft> doesn't accept that prop. Declared props: title, repeat, kid, time, points, reminder, memo."
      },
      {
        "selector": "JSXOpeningElement[name.name='GoalDraft'] > JSXAttribute[name.name='repeat'] > Literal[value!=/^(?:|daily|weekdays|weekend|weekly)$/]",
        "message": "<GoalDraft> repeat must be one of '' | 'daily' | 'weekdays' | 'weekend' | 'weekly'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GoalDraft'] > JSXAttribute[name.name='time'] > Literal[value!=/^(?:any|morning|afternoon|evening)$/]",
        "message": "<GoalDraft> time must be one of 'any' | 'morning' | 'afternoon' | 'evening'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|label|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|onSelect|disabled|danger|separatorBefore|key|ref|className|style|children)$/]",
        "message": "<MenuItem> doesn't accept that prop. Declared props: id, label, onSelect, disabled, danger, separatorBefore."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mission'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|points|key|ref|className|style|children)$/]",
        "message": "<Mission> doesn't accept that prop. Declared props: id, title, points."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pagination'] > JSXAttribute > JSXIdentifier[name!=/^(?:page|pageCount|onPageChange|disabled|label|previewState|key|ref|className|style|children)$/]",
        "message": "<Pagination> doesn't accept that prop. Declared props: page, pageCount, onPageChange, disabled, label, previewState."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pagination'] > JSXAttribute[name.name='previewState'] > Literal[value!=/^(?:hover|focus)$/]",
        "message": "<Pagination> previewState must be one of 'hover' | 'focus'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|description|error|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, description, error."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|circle|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: width, height, circle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|header|cell|sortValue|align|key|ref|className|style|children)$/]",
        "message": "<TableColumn> doesn't accept that prop. Declared props: id, header, cell, sortValue, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='TableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<TableColumn> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|description|error|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: label, description, error."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|description|error|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, description, error."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToastOptions'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|tone|id|duration|priority|action|key|ref|className|style|children)$/]",
        "message": "<ToastOptions> doesn't accept that prop. Declared props: title, description, tone, id, duration, priority, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToastOptions'] > JSXAttribute[name.name='priority'] > Literal[value!=/^(?:polite|assertive)$/]",
        "message": "<ToastOptions> priority must be one of 'polite' | 'assertive'."
      }
    ]
  },
