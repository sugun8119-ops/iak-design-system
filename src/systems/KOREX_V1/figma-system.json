  "semanticRoles": {
    "note": "No new hues. State is carried by icon + word first; color supports.",
    "success": "primary + check icon",
    "warning": "surface + textPrimary border + alert icon",
    "error": "textPrimary fill or 2px textPrimary border + alert/close icon + '오류' word",
    "danger": "textPrimary fill + trash icon + explicit verb",
    "info": "surface + textSecondary border + info icon",
    "selected": "primary fill/border + check or bold",
    "disabled": "border / canvas surface + textSecondary text",
    "focus": "2px textPrimary outline, offset 4 (surface on dark panels)"
  },
