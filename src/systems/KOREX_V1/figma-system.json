    "typography": {
      "display": {
        "family": "Sans",
        "size": 52,
        "lineHeight": 60,
        "weight": 700
      },
      "heading": {
        "family": "Sans",
        "size": 32,
        "lineHeight": 40,
        "weight": 700
      },
      "title": {
        "family": "Sans",
        "size": 20,
        "lineHeight": 28,
        "weight": 600
      },
      "body": {
        "family": "Sans",
        "size": 15,
        "lineHeight": 25,
        "weight": 400
      },
      "meta": {
        "family": "Sans",
        "size": 12,
        "lineHeight": 18,
        "weight": 500
      }
