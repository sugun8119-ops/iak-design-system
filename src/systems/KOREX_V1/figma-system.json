{
  "id": "KOREX_V1",
  "name": "KOREX Brand Web System",
  "version": "1.6.0",
  "category": "Corporate / Brand / Product Web",
  "foundation": {
    "colors": {
      "canvas": "#F5F6F2",
      "surface": "#FFFFFF",
      "textPrimary": "#172019",
      "textSecondary": "#677068",
      "border": "#D9DED8",
      "primary": "#07523D",
      "primaryDark": "#04382B",
      "primarySoft": "#DCE8E3"
