  "provenance": {
    "reference": "https://www.behance.net/gallery/110574641/DEW-Webzine-Editorial-Web-Experience-Design",
    "basis": "Prior approved tokens + public portfolio thumbnail observed 2026-09-25. Detail page returned HTTP 403.",
    "precision": "Normalized reusable values inherited from v1.0; not sampled measurements or original source tokens. v1.1 additions are derived-extension.",
    "assets": "No original logos, copy, photography or real records are included.",
    "extensions": "v1.1 adds 16 common families, template states, icon set and one scrim token as derived-extension; IAK provided coverage only.",
    "inheritance": {
      "inheritedFromNormalizedV1_0": [
        "foundation.colors (7)",
        "foundation.typography (5)",
        "foundation.spacing (9)",
        "foundation.radius (3)",
        "foundation.grid",
        "responsive",
        "11 editorial components",
        "3 templates"
      ],
      "note": "Inherited values are the previously agreed normalized reusable tokens (public Behance thumbnail + agreed direction). They are not precise measurements extracted from the original Behance project.",
      "derivedExtension": [
        "16 common families (IAK coverage list, DEW visuals)",
        "template states (14)",
        "icon set (27)",
        "scrim token",
        "missing-image / loading states on editorial components",
        "AlertDialog error + retry",
        "ArticleList sort Menu + Pagination",
        "control heights, dialog widths, motion, Korean line-break rule"
      ]
    }
  },
  "responsive": {
    "unit": "px",
    "breakpoints": {
      "mobile": "0–767",
      "tablet": "768–1023",
      "desktop": "1024+"
    },
    "frameWidths": [
      1440,
      834,
      390
    ],
    "pagePadding": {
      "desktop": 48,
      "tablet": 32,
      "mobile": 24
    },
    "mobileTypography": {
      "display": {
        "size": 40,
        "lineHeight": 44
      },
      "heading": {
        "size": 32,
        "lineHeight": 40
      }
    },
    "verificationWidths": [
      1440,
      834,
      390,
      375
    ]
  },
  "fontMapping": {
    "Serif": {
      "figma": "Noto Serif KR",
      "figmaStyle": "Medium (500)",
      "web": "Georgia, \"Noto Serif KR\", serif",
      "usedBy": [
        "display",
        "heading"
      ]
    },
    "Sans": {
      "figma": "Inter",
      "figmaStyle": "Regular 400 / Medium 500 / Semi Bold 600 per text style",
      "web": "Arial, \"Noto Sans KR\", sans-serif",
      "usedBy": [
        "title",
        "body",
        "meta"
      ]
    },
    "note": "Figma already has Noto Serif KR Medium headings and Inter body styles; this file matches them. Sizes, line heights and weights are identical on both sides, but glyph widths are not: the web renders Georgia / Arial first (then an installed Noto face for Hangul), so line breaks and heading line counts can differ from Figma. Inter has no Hangul glyphs, so Korean body text in Figma is drawn by a fallback font. Font files are not bundled."
  },
