    "AlertDialog": {
      "layout": "Dialog sm + 2px accent top rule for danger; cancel secondary + confirm danger",
      "anatomy": "icon, heading, description, actions",
      "variants": [
        "Danger",
        "Default",
        "Loading",
        "ErrorRetry",
        "Long"
      ],
      "status": "derived-extension",
      "coverageSource": "IAK common family",
      "errorRetry": {
        "status": "derived-extension",
        "layout": "surface box, 1px accent border, radius 0, padding 16, gap 16, above the footer",
        "anatomy": "accent error icon 20, textPrimary title (600), textSecondary message, role=alert",
        "action": "confirm button becomes '다시 시도' with refresh icon (same danger/primary variant); dialog stays open; cancel stays secondary"
      }
    },
    "Menu": {
      "layout": "surface panel, 1px textPrimary, padding 8/0, items min 44h padding 8/16, width 240–320",
      "anatomy": "trigger Button, items(icon, label, description), separator",
      "variants": [
