 "editorial": {
  "library": "dew/lib/editorial.js",
  "css": "dew/editorial.css",
  "global": "window.DEW_ED",
  "basis": "derived-extension on observed DEW layout language",
  "preview": "dew/kits/front-page.html",
  "pages": [
   {
    "name": "EditorialHome",
    "view": "home"
   },
   {
    "name": "ArticleList",
    "view": "list",
    "states": [
     "default",
     "loading",
     "empty"
    ]
   },
   {
    "name": "StoryDetail",
    "view": "story"
   }
  ],
  "parts": {
   "EditorialHeader": {
    "props": {
     "issue": "string",
     "tagline": "string",
     "title": "string",
     "compact": "boolean"
    }
   },
   "CategoryNav": {
    "props": {
     "items": "string[]",
     "current": "string",
     "onSelect": "(item)=>void",
     "label": "string"
    },
    "states": [
     "default",
     "hover",
     "current (red 2px underline)",
     "focus 2/2"
    ]
   },
   "FeatureStory": {
    "props": {
     "story": "Story",
     "reverse": "boolean"
    },
    "layout": "8/4 split, 12 cols; stacked ≤1024"
   },
   "StoryCard": {
    "props": {
     "story": "Story",
     "layout": "\"stack\"|\"row\"",
     "loading": "boolean"
    },
    "states": [
     "default",
     "hover (title → red)",
     "focus",
     "loading",
     "long title",
     "missing author/title"
    ]
   },
   "MediaCard": {
    "props": {
     "label": "string",
     "ratio": "string",
     "tone": "\"light\"|\"mid\"|\"dark\"",
     "kind": "\"video\"|\"gallery\"",
     "caption": "string",
     "credit": "string"
    }
   },
   "EditorialGrid": {
    "props": {
     "asymmetric": "boolean",
     "children": "node"
    },
    "layout": "5/4/3 staggered (64/24px offsets); 6/6 ≤1024; 12 ≤640"
   },
   "QuoteBlock": {
    "props": {
     "quote": "string",
     "cite": "string"
    },
    "type": "serif italic 40/1.2 (28 ≤640)"
   },
   "ImageCaption": {
    "props": {
     "caption": "string",
     "credit": "string"
    },
    "states": [
     "caption+credit",
     "missing caption"
    ]
   },
   "ArticleMeta": {
    "props": {
     "category": "string",
     "author": "string",
     "photographer": "string",
     "date": "string",
     "read": "string"
    },
    "states": [
     "full",
     "missing author"
    ]
   },
   "EditorialCTA": {
    "props": {
     "title": "string",
     "body": "string",
     "tone": "\"dark\"|\"light\"",
     "state": "\"default\"|\"error\"|\"success\""
    }
   },
   "Footer": {
    "props": {}
   }
  }
 }
