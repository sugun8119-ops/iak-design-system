{
  "$meta": {
    "name": "RAIS · Motion tokens",
    "version": "2026.05.10k",
    "principle": "Three durations, one easing curve. Respect prefers-reduced-motion. No bounce."
  },

  "duration": {
    "fast":    { "value": 120, "unit": "ms", "$usage": "Hover, pressed, focus, micro-feedback." },
    "default": { "value": 180, "unit": "ms", "$usage": "Toast, dropdown, accordion, tooltip." },
    "slow":    { "value": 240, "unit": "ms", "$usage": "Modal enter/exit, sidebar collapse." }
  },

  "easing": {
    "out":   { "value": "cubic-bezier(0.16, 1, 0.30, 1)", "$usage": "Default for everything that lands on screen." },
    "inout": { "value": "cubic-bezier(0.40, 0, 0.20, 1)", "$usage": "Symmetric transitions (modal open/close)." }
  },

  "patterns": {
    "hover":     { "duration": "fast",    "easing": "out" },
    "pressed":   { "duration": "fast",    "easing": "out" },
    "modal":     { "duration": "slow",    "easing": "inout" },
    "toast":     { "duration": "default", "easing": "out" },
    "loading":   { "duration": "default", "easing": "out" },
    "accordion": { "duration": "default", "easing": "out" },
    "sidebar":   { "duration": "slow",    "easing": "inout" },
    "dropdown":  { "duration": "default", "easing": "out" }
  },

  "$rules": {
    "no-bounce": "Never use spring or back-out easing.",
    "reduce-motion": "All durations collapse to 1 ms under prefers-reduced-motion: reduce.",
    "scope": "Animate transform, opacity and color only — never width, height or top/left."
  }
}
